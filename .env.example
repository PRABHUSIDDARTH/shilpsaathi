# Copy these names into .env and fill in the values there. Never put real values in this file.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs of the demo artisans.
# Leave empty on first run: the bot stores nothing and replies with your user ID.
ARTISAN_TELEGRAM_IDS=

# Google AI Studio key (used from M2)
GEMINI_API_KEY=

# Optional: only if Whisper on Groq wins the speech-to-text test (M2)
GROQ_API_KEY=

# Where photos and voice notes are stored (git-ignored)
MEDIA_DIR=var/media
